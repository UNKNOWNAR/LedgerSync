FROM python:3.12-slim

WORKDIR /app

# Install system dependencies if necessary (e.g. gcc for certain python packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application
COPY . .

# Add the project root to PYTHONPATH so imports work correctly
ENV PYTHONPATH=/app

# The command will be overridden in docker-compose.yml for api vs worker
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]

